    {
      "label": "WATCHER: bundle both (debug)",
      "type": "process",
      "command": "${workspaceFolder}/typst.exe",
      "args": [
        "watch",
        "--features", "bundle,html",
        "--format", "bundle",
        "--package-path", "packages",
        "--font-path", "src/assets/fonts",
        "--input", "debug-build=true",
        "main.typ", "dist"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
